/* Adafruit SCD-40 on I2C1 (SCL=PB8, SDA=PB9). The board dts already enables
 * i2c1 with the right pinctrl, so we add only the sensor child node. */
&i2c1 {
	scd40: scd40@62 {
		compatible = "sensirion,scd40";
		reg = <0x62>;
		status = "okay";

		/* Skip the boot-time init sweep; src/sensor.cpp calls device_init()
		 * itself once the sensor's 30 ms power-up window has passed. The
		 * board and the sensor share a rail, so on a cold plug-in the MCU
		 * can otherwise reach the driver's POST_KERNEL init while the chip
		 * is still coming up -- and a failed init latches permanently. The
		 * reasoning is in src/sensor.cpp; do not remove one without the
		 * other. */
		zephyr,deferred-init;
	};
};
