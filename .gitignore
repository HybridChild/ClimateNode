# Zephyr build output
build/
*.build/

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS
# Share project-mechanics config (clangd wiring, extension picks); ignore the rest
# (per-user files like launch.json with local debugger paths).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# clangd index (regenerated by the language server)
.cache/
.DS_Store

# Personal learning notes (study order, scratch understanding). Project
# documentation belongs in docs/ and is tracked.
notes/
