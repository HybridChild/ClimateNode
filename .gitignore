# Zephyr build output
build/
*.build/

# Twister's per-suite build trees, logs and reports (scripts/test.sh). Rebuilt
# on every run; twister rotates old ones to twister-out.N itself.
twister-out/
twister-out.*/

# Merged clangd database (scripts/ide-index.sh), built from the two trees above.
# Editor-only, and full of machine-specific absolute paths. Regenerate it by
# running that script; nothing in the build reads it.
/compile_commands.json

# Python
__pycache__/
*.pyc
.venv/

# Generated from proto/node.proto by host/generate.sh. The .proto is the source
# of truth; generated code is never checked in and never hand-edited.
host/node_pb2.py
host/*_pb2.pyi

# Serial console captures (scripts/console.sh, or `screen -X hardcopy`). Useful
# while debugging, never worth keeping — paste the interesting lines into a
# commit message or a doc instead, where they carry their context.
console*.txt

# Editor / OS
# Share project-mechanics config (clangd wiring, extension picks); ignore the rest
# (per-user files like launch.json with local debugger paths).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# clangd index (regenerated by the language server)
.cache/
.DS_Store
